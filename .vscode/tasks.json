{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: watch",
      "type": "shell",
      "command": "bun run watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "bun: compile",
      "type": "shell",
      "command": "bun run compile",
      "problemMatcher": "$tsc"
    },
    {
      "label": "bun: test",
      "type": "shell",
      "command": "bun test",
      "problemMatcher": []
    }
  ]
}
